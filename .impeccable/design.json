      "refersTo": "nav-active",
      "description": "A navy destination list with an explicit active location.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace preview\"><a class=\"ds-nav-link ds-active\" href=\"/orders\" aria-current=\"page\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V2h6v2M9 9h6M9 13h6M9 17h3\"/></svg><span>Orders &amp; tracking</span><span class=\"ds-active-mark\"></span></a><a class=\"ds-nav-link\" href=\"/inventory\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 7 9-4 9 4-9 4-9-4Zm0 0v10l9 4 9-4V7M12 11v10M7.5 5 17 9\"/></svg><span>Inventory</span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px;background:var(--navy,#172e43);padding:18px;font-family:Plex, 'Segoe UI', sans-serif;}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:44px;padding:12px 13px;border-radius:6px;font-size:13px;line-height:1.5;color:#d4e0e7;text-decoration:none;}.ds-nav-link:hover{background:#203d52;color:#fff;}.ds-nav-link.ds-active{background:var(--navy-active,#29485f);color:#fff;font-weight:500;}.ds-active-mark{width:5px;height:5px;border-radius:50%;background:#8bd2c5;margin-left:auto;}.ds-nav .ds-icon{flex:none;}.ds-nav-link:focus-visible{outline:3px solid #40a99c;outline-offset:3px;}"
    },
    {
      "name": "Operational statuses",
      "kind": "chip",
      "refersTo": "badge-submitted",
      "description": "Text-bearing order and inventory statuses with fixed semantic colors.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-submitted\"><span class=\"ds-dot\"></span>Submitted</span><span class=\"ds-badge ds-processing\"><span class=\"ds-dot\"></span>Processing</span><span class=\"ds-badge ds-shipped\"><span class=\"ds-dot\"></span>Shipped</span><span class=\"ds-badge ds-positive\"><span class=\"ds-dot\"></span>Delivered</span><span class=\"ds-badge ds-cancelled\"><span class=\"ds-dot\"></span>Cancelled</span><span class=\"ds-badge ds-low\"><span class=\"ds-dot\"></span>Low stock</span><span class=\"ds-badge ds-critical\"><span class=\"ds-dot\"></span>Expired</span></div>",
      "css": ".ds-badges{display:flex;flex-wrap:wrap;gap:8px;}.ds-badge{display:inline-flex;align-items:center;gap:5px;font-family:Plex, 'Segoe UI', sans-serif;font-size:10px;font-weight:500;line-height:1.2;padding:5px 8px;border-radius:4px;white-space:nowrap;}.ds-dot{width:4px;height:4px;border-radius:50%;background:currentColor;}.ds-submitted{background:#edf2f7;color:#4b6681;}.ds-processing{background:#fff3dc;color:#875b12;}.ds-shipped{background:#eaf0fc;color:#4866a2;}.ds-positive{background:#e9f4ec;color:#35714b;}.ds-cancelled{background:#eef0f2;color:#53616c;}.ds-low{background:var(--amber-wash,#fff5e4);color:var(--amber,#8c5a12);}.ds-critical{background:var(--danger-wash,#fff0ed);color:var(--danger,#a53637);}"
    },
    {
      "name": "Table panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A flat bordered work surface with a contained, labeled data table.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Order items</h2><div class=\"ds-table-scroll\" role=\"region\" aria-label=\"Order items preview\" tabindex=\"0\"><table class=\"ds-table\"><caption class=\"ds-caption\">Order items preview</caption><thead><tr><th>Medication</th><th class=\"ds-number\">Packs</th><th class=\"ds-number\">Pack price</th></tr></thead><tbody><tr><td>Amoxicillin 500 mg</td><td class=\"ds-number\">4</td><td class=\"ds-number\">$12.50</td></tr></tbody></table></div></section>",
      "css": ".ds-panel{background:var(--white,#fff);color:var(--ink,#23394a);border:1px solid var(--line,#e0e6e9);border-radius:var(--radius,12px);overflow:hidden;font-family:Plex, 'Segoe UI', sans-serif;font-variant-numeric:tabular-nums;}.ds-panel-title{margin:0;padding:23px 24px;font-size:16px;font-weight:600;line-height:1.25;letter-spacing:-.025em;}.ds-table-scroll{overflow-x:auto;min-width:0;max-width:100%;}.ds-table{border-collapse:collapse;width:100%;font-size:12px;line-height:1.5;text-align:left;white-space:nowrap;}.ds-table th{background:#f8fafb;border-top:1px solid var(--line,#e0e6e9);border-bottom:1px solid var(--line,#e0e6e9);padding:12px 18px;font-weight:500;color:#617480;font-size:11px;}.ds-table td{padding:16px 18px;border-bottom:1px solid #eaf0f2;}.ds-table tr:last-child td{border-bottom:0;}.ds-table tr:hover td{background:#fcfdfd;}.ds-table th:first-child,.ds-table td:first-child{padding-left:24px;}.ds-table th:last-child,.ds-table td:last-child{padding-right:24px;}.ds-number{text-align:right;}.ds-caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;}.ds-table-scroll:focus-visible{outline:3px solid #40a99c;outline-offset:3px;}"
    },
    {
      "name": "Fulfillment strip",
      "kind": "custom",
      "refersTo": "tracking-current",
      "description": "Four connected fulfillment stages with completed, current, and upcoming text.",
      "html": "<ol class=\"ds-tracking\"><li class=\"ds-reached\"><span class=\"ds-stop\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>Submitted</strong><small>Complete</small></li><li class=\"ds-reached ds-current\"><span class=\"ds-stop\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 7 9-4 9 4-9 4-9-4Zm0 0v10l9 4 9-4V7M12 11v10\"/></svg></span><strong>Processing</strong><small>Current status</small></li><li><span class=\"ds-stop\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 5h12v12H3V5Zm12 5h3l3 4v3h-6\"/><circle cx=\"7\" cy=\"18\" r=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"2\"/></svg></span><strong>Shipped</strong><small>Upcoming</small></li><li><span class=\"ds-stop\"><svg class=\"ds-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><strong>Delivered</strong><small>Upcoming</small></li></ol>",
      "css": ".ds-tracking{list-style:none;padding:12px 30px 25px;margin:0;display:flex;background:#fff;font-family:Plex, 'Segoe UI', sans-serif;}.ds-tracking li{position:relative;flex:1;text-align:center;font-size:11px;line-height:1.5;color:#586c79;}.ds-tracking li::before{content:\"\";position:absolute;height:2px;background:#e4eaed;top:17px;left:0;width:100%;}.ds-tracking li:first-child::before{left:50%;width:50%;}.ds-tracking li:last-child::before{width:50%;}.ds-tracking li.ds-reached::before{background:#a2c9b9;}.ds-stop{position:relative;z-index:1;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#edf1f3;color:#82939e;border:5px solid white;box-sizing:content-box;margin:0 auto 7px;top:-5px;}.ds-stop .ds-icon{width:17px;height:17px;}.ds-reached .ds-stop{background:var(--teal-wash,#e9f4f0);color:var(--teal,#177b70);}.ds-current .ds-stop{background:var(--teal,#177b70);color:#fff;}.ds-tracking strong{display:block;font-size:11px;font-weight:600;margin-top:-2px;}.ds-reached strong{color:var(--ink,#23394a);}.ds-tracking small{display:block;font-size:9px;margin-top:4px;}"
    }
  ],
  "narrative": {
    "northStar": "The Distribution Service Guide",
    "overview": "The Distribution Service Guide gives MediSupply a steady, legible working identity. Ink-navy navigation anchors white work surfaces on a cool pale ground; forest and eucalyptus colors identify actions and progress. Light rules, aligned figures, and modest corner rounding support repeated scanning of medication, pack, price, lot, and order information.\n\nIBM Plex Sans carries the entire interface. The product's visual character comes from consistent density and restrained state changes, with a connected fulfillment strip as its recurring progress pattern. Native controls, explicit labels, and text-bearing statuses keep the interface familiar. Motion is brief feedback for an action.",
    "keyCharacteristics": [
      "Ink-navy identity with forest and eucalyptus action colors.",
      "Compact tables, tabular figures, and explicit status text.",
      "Flat white panels separated by light rules and a cool ground.",
      "Native form controls and a connected fulfillment strip."
    ],
    "rules": [
      {
        "name": "The Text-Bearing Status Rule",
        "body": "Every status pairs its color with a readable label; color and the small dot are supporting signals.",
        "section": "colors"
      },
      {
        "name": "The Aligned Figures Rule",
        "body": "Use tabular numerals throughout and right-align price, quantity, and total columns.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Keep ordinary panels and tables free of shadows; reserve elevation for the selected sign-in role, notifications, and modal dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the established navy, teal, neutral, and status roles for their existing purposes.",
      "Do keep prices, pack quantities, totals, and dates easy to compare with tabular figures.",
      "Do retain native labeled controls, visible keyboard focus, and text for every status.",
      "Do contain wide tables inside labeled, keyboard-focusable horizontal scroll regions.",
      "Do preserve the compact control scale and the larger panel spacing as separate levels of density.",
      "Do disable repeated submissions while a request is pending and show errors close to the relevant form."
    ],
    "donts": [
      "Don't turn ordinary data panels into floating cards with shadows.",
      "Don't replace native selects, numeric inputs, or dialogs with decorative imitations.",
      "Don't use color alone to communicate availability or order progress.",
      "Don't let a wide table force the whole page to scroll horizontally.",
      "Don't extend the brief notification animation into continuous or ambient motion."
    ]
  }
}
